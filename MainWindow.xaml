<local:NotifyingWindow x:Class="A2G_Setup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localizer="clr-namespace:Localizer"
        xmlns:local="clr-namespace:A2G_Setup"
        mc:Ignorable="d"
        Title="A2G-Setup" Height="450" Width="800" Background="#F0F0F0" WindowStartupLocation="CenterScreen" Topmost="True">
    <Window.Resources>
        <local:VersionToBoolConverter x:Key="VersionToBoolConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:BoolInverterConverter x:Key="BoolInverterConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Height="50" ToolTip="{localizer:LocalizedText Nr=10001}">
            <Label Content="{localizer:LocalizedText Nr=10000}" FontSize="16" FontWeight="Bold" VerticalContentAlignment="Center" Margin="25,0,0,0"/>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" Cursor="Hand" >
                <Image Source="Localization/de-en.png" Stretch="Uniform">
                    <Image.Effect>
                        <DropShadowEffect/>
                    </Image.Effect>
                </Image>
                <Button Click="btChangeLanguage" Opacity="0"/>
            </Grid>
        </Grid>
        <Image Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.4" Margin="5">
            <Image.Style>
                <Style TargetType="{x:Type Image}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ElementName=cbCDVersion, Path=SelectedIndex}" Value="0">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard Name="CarouselStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Source" Duration="0:0:6">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <BitmapImage UriSource="Resources/Covers/A2G.jpg" />
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:3">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <BitmapImage UriSource="Resources/Covers/A2G_B2G.jpg" />
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="CarouselStoryboard" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding ElementName=cbCDVersion, Path=SelectedIndex}" Value="1">
                            <Setter Property="Source" Value="Resources/Covers/A2007.jpg"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="5,0,0,0">
            <Border BorderBrush="#B8B8B8" BorderThickness="0,1,0,0"/>
            <Border BorderBrush="White" BorderThickness="0,1,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Vertical" Grid.IsSharedSizeScope="True" Margin="5,5,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" SharedSizeGroup="Description"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{localizer:LocalizedText Nr=10009}"/>
                <ComboBox Name="cbCDVersion" Grid.Column="2" SelectedIndex="0" VerticalContentAlignment="Center" IsEnabled="{Binding IsInstalling, Converter={StaticResource BoolInverterConverter}}">
                    <ComboBoxItem Content="{localizer:LocalizedText Nr=10010}" Tag="{x:Static local:Version.A2G}"/>
                    <ComboBoxItem Content="{localizer:LocalizedText Nr=10011}" Tag="{x:Static local:Version.A2007}"/>
                </ComboBox>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Description"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{localizer:LocalizedText Nr=10012}"/>
                <TextBox Grid.Column="2" Text="{Binding CDPath}" VerticalContentAlignment="Center" IsReadOnly="True" IsEnabled="{Binding IsInstalling, Converter={StaticResource BoolInverterConverter}}"/>
                <Button Grid.Column="4" Content="..." Click="btSelectCDPath_Click" Cursor="Hand" IsEnabled="{Binding IsInstalling, Converter={StaticResource BoolInverterConverter}}"/>
            </Grid>
            <GroupBox Header="{localizer:LocalizedText Nr=10016}" Margin="0,5,0,0" Width="405" HorizontalAlignment="Left">
                <StackPanel  Orientation="Vertical" Margin="5" IsEnabled="{Binding IsInstalling, Converter={StaticResource BoolInverterConverter}}">
                    <CheckBox x:Name="cbOTVDM" Content="{localizer:LocalizedText Nr=10018}" IsChecked="True" IsThreeState="False" IsEnabled="{Binding ElementName=cbCDVersion, Path=SelectedItem.Tag, Converter={StaticResource VersionToBoolConverter}, ConverterParameter=otvdm}" Cursor="Hand"/>
                    <CheckBox x:Name="cbKLITE" Content="{localizer:LocalizedText Nr=10014}" IsChecked="True" IsThreeState="False" Margin="0,5,0,0" IsEnabled="{Binding ElementName=cbCDVersion, Path=SelectedItem.Tag, Converter={StaticResource VersionToBoolConverter}, ConverterParameter=klite}" Cursor="Hand"/>
                    <CheckBox x:Name="cbWINED3D" Content="{localizer:LocalizedText Nr=10015}" IsChecked="True" IsThreeState="False" Margin="0,5,0,0" IsEnabled="{Binding ElementName=cbCDVersion, Path=SelectedItem.Tag, Converter={StaticResource VersionToBoolConverter}, ConverterParameter=wined3d}" Cursor="Hand"/>
                    <CheckBox x:Name="cb16BIT" Content="{localizer:LocalizedText Nr=10017}" IsChecked="True" IsThreeState="False" Margin="0,5,0,0" IsEnabled="{Binding ElementName=cbCDVersion, Path=SelectedItem.Tag, Converter={StaticResource VersionToBoolConverter}, ConverterParameter=16bitcol}" Cursor="Hand"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>
        <StackPanel Grid.Row="3"  Orientation="Vertical" Margin="5,0,0,0">
            <Border BorderBrush="#B8B8B8" BorderThickness="0,1,0,0"/>
            <Border BorderBrush="White" BorderThickness="0,1,0,0"/>
        </StackPanel>

        <Grid Grid.Row="4" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="2" Height="26" Margin="5,0,5,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressBar IsIndeterminate="{Binding IsInstalling}" />
                <TextBlock Text="{Binding InstallStep}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>
            
            <StackPanel Grid.Column="2"  Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button Content="{localizer:LocalizedText Nr=10003}" VerticalAlignment="Center" Width="80" Padding="2" Margin="10,0,10,0" Click="btExit_Click" Cursor="Hand"/>
                <Button Content="{localizer:LocalizedText Nr=10008}" VerticalAlignment="Center" Width="80" Padding="2" Click="btInstall_Click" Cursor="Hand" IsEnabled="{Binding IsInstalling, Converter={StaticResource BoolInverterConverter}}"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</local:NotifyingWindow>
